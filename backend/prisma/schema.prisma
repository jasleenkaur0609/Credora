generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum RelationshipType {
  PRIMARY
  JOINT
  GUARANTOR
  NOMINEE
  CO_APPLICANT
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  users     User[]
  customers Customer[]

  @@index([isActive])
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  country        String?  @default("India")
  postalCode     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]
  customers    Customer[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
}

model User {
  id              String     @id @default(uuid())
  organizationId  String
  branchId        String?
  firebaseUid     String     @unique
  email           String     @unique
  firstName       String
  lastName        String?
  phone           String?
  status          UserStatus @default(ACTIVE)
  isEmailVerified Boolean    @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles    UserRole[]
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Customer {
  id             String         @id @default(uuid())
  organizationId String
  branchId       String?
  customerNumber String         @unique
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  relationships CustomerRelationship[] @relation("CustomerRelationships")
  relatedTo     CustomerRelationship[] @relation("RelatedCustomerRelationships")
  auditLogs     AuditLog[]

  @@index([organizationId])
  @@index([branchId])
  @@index([email])
  @@index([phone])
  @@index([status])
}

model CustomerRelationship {
  id                String           @id @default(uuid())
  customerId        String
  relatedCustomerId String
  relationshipType  RelationshipType
  createdAt         DateTime         @default(now())

  customer        Customer @relation("CustomerRelationships", fields: [customerId], references: [id], onDelete: Cascade)
  relatedCustomer Customer @relation("RelatedCustomerRelationships", fields: [relatedCustomerId], references: [id], onDelete: Cascade)

  @@unique([customerId, relatedCustomerId, relationshipType])
  @@index([customerId])
  @@index([relatedCustomerId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  customerId  String?
  action      String
  resource    String
  resourceId  String?
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerId])
  @@index([resource])
  @@index([resourceId])
  @@index([action])
  @@index([createdAt])
}
