generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum RelationshipType {
  PRIMARY
  JOINT
  GUARANTOR
  NOMINEE
  CO_APPLICANT
}

// ============================================================
// ORGANIZATION
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  users     User[]
  customers Customer[]

  @@index([isActive])
}

// ============================================================
// BRANCH
// ============================================================

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  country        String?  @default("India")
  postalCode     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]
  customers    Customer[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
}

// ============================================================
// USER
// ============================================================

model User {
  id             String     @id @default(uuid())
  organizationId String
  branchId       String?
  firebaseUid    String     @unique
  email          String     @unique
  firstName      String
  lastName       String?
  phone          String?
  status         UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)

  // First-login security
  mustResetPassword Boolean @default(false)

  // Multi-factor authentication
  mfaEnabled Boolean @default(false)

  // Account protection
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Login tracking
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles    UserRole[]
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([email])
}

// ============================================================
// ROLE
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

// ============================================================
// PERMISSION
// ============================================================

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
}

// ============================================================
// USER ROLE
// ============================================================

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ============================================================
// ROLE PERMISSION
// ============================================================

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ============================================================
// CUSTOMER
// ============================================================

model Customer {
  id             String         @id @default(uuid())
  organizationId String
  branchId       String?
  customerNumber String         @unique
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  relationships CustomerRelationship[] @relation("CustomerRelationships")
  relatedTo     CustomerRelationship[] @relation("RelatedCustomerRelationships")
  auditLogs     AuditLog[]

  @@index([organizationId])
  @@index([branchId])
  @@index([email])
  @@index([phone])
  @@index([status])
}

// ============================================================
// CUSTOMER RELATIONSHIP
// ============================================================

model CustomerRelationship {
  id                String           @id @default(uuid())
  customerId        String
  relatedCustomerId String
  relationshipType  RelationshipType
  createdAt         DateTime         @default(now())

  customer        Customer @relation("CustomerRelationships", fields: [customerId], references: [id], onDelete: Cascade)
  relatedCustomer Customer @relation("RelatedCustomerRelationships", fields: [relatedCustomerId], references: [id], onDelete: Cascade)

  @@unique([customerId, relatedCustomerId, relationshipType])
  @@index([customerId])
  @@index([relatedCustomerId])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String  @id @default(uuid())
  userId     String?
  customerId String?

  action      String
  resource    String
  resourceId  String?
  description String?

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerId])
  @@index([resource])
  @@index([resourceId])
  @@index([action])
  @@index([createdAt])
}
